---
import Layout from '../layouts/Layout.astro';

const tools = [
  {
    name: 'VPS Budget Tribunal',
    href: '/vps-budget',
    blurb: 'Tell us what you want to host and how little you want to pay. We judge the budget.',
    status: 'live',
  },
  {
    name: 'Am I Being a Dick?',
    href: '/am-i-a-dick',
    blurb: 'Describe a dilemma, answer a few questions, get a verdict you can argue with.',
    status: 'planned',
  },
];
---

<Layout title="dontbeadick.lol">
  <main class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center gap-12 px-6 py-20">
    <header class="space-y-4">
      <p class="font-mono text-xs tracking-[0.3em] text-neutral-500 uppercase">
        est. 2026
      </p>
      <h1
        class="text-4xl font-bold tracking-tight text-balance sm:text-6xl"
      >
        dontbeadick<span class="text-lime-400">.lol</span>
      </h1>
      <p class="max-w-prose text-lg text-neutral-400">
        A small collection of useful tools with unhelpful attitudes.
      </p>
    </header>

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        tools.map((tool) => (
          <li class="rounded-xl border border-neutral-800 bg-neutral-900/40 p-5">
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="font-semibold text-neutral-100">
                {tool.status === 'live' ? (
                  <a class="hover:text-lime-400" href={tool.href}>
                    {tool.name} →
                  </a>
                ) : (
                  tool.name
                )}
              </h2>
              <span
                class={`font-mono text-[10px] tracking-widest uppercase ${
                  tool.status === 'live' ? 'text-lime-500' : 'text-neutral-600'
                }`}
              >
                {tool.status}
              </span>
            </div>
            <p class="mt-2 text-sm text-neutral-400">{tool.blurb}</p>
          </li>
        ))
      }
    </ul>

    <footer class="border-t border-neutral-900 pt-6 text-sm text-neutral-600">
      <a class="hover:text-neutral-300" href="https://lowendtalk.com">Ask the
        experts</a>
    </footer>
  </main>
</Layout>

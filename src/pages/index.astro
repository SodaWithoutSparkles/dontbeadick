---
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';

const tools = [
  {
    name: 'VPS Budget Tribunal',
    href: '/vps-budget',
    blurb: 'Tell us what you want to host and how little you want to pay. We judge the budget.',
    status: 'live',
  },
  {
    name: 'Am I Being a Dick?',
    href: '/am-i-a-dick',
    blurb: 'Describe a dilemma, answer a few questions, get a verdict you can argue with.',
    status: 'planned',
  },
];
---

<Layout title="dontbeadick.lol">
  <header class="site-header">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
      <span class="wordmark">
        <span class="wordmark-mark" aria-hidden="true">d/</span>
        <span>dontbeadick<span class="font-normal text-[#7b857c]">.lol</span></span>
      </span>
      <div class="flex items-center gap-2 text-[11px] font-medium text-[#68736a]">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-[#568564]"></span>
        <span>Small tools for the internet</span>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-6xl px-5 pb-10 pt-12 sm:px-8 sm:pt-16">
    <section class="mb-9 sm:mb-11">
      <p class="eyebrow mb-3">DON'T BE A DICK <span class="mx-1 text-[#b6beb6]">/</span> EST. 2026</p>
      <h1 class="hero-title">Tools with<br class="hidden sm:block" /> unhelpful attitudes.</h1>
      <p class="hero-copy mt-4">
        A small collection of practical, mildly rude internet tools. Describe your
        problem, get a straight answer, and go do the thing. No accounts, no
        tracking, no newsletter.
      </p>
    </section>

    <div class="grid items-start gap-5 sm:grid-cols-2">
      {
        tools.map((tool) => {
          const Tag = tool.status === 'live' ? 'a' : 'div';
          return (
            <Tag href={tool.status === 'live' ? tool.href : undefined} class="tool-card">
              <div class="tool-card-head">
                <h2 class="tool-card-name">{tool.name}</h2>
                <span class="status-tag" data-status={tool.status}>
                  {tool.status}
                </span>
              </div>
              <p class="tool-card-blurb">{tool.blurb}</p>
              <p class="tool-card-cta">
                {tool.status === 'live' ? 'Open the tribunal →' : 'Not built yet'}
              </p>
            </Tag>
          );
        })
      }
    </div>
  </main>

  <SiteFooter>
    <p>I bought the domain for cheap and don't know what to do with it. Issues and PR's welcome.</p>
  </SiteFooter>
</Layout>